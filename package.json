{
  "name": "neet-note-app",
  "version": "1.0.0",
  "private": true,
  "description": "NEET NOTE native app wrapper",
  "type": "module",
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build:theory-static": "node scripts/build-theory-static.mjs",
    "test:theory": "node scripts/test-theory-os.mjs",
    "cap:sync": "npm run build:native && cap sync",
    "ios": "npm run cap:sync && cap open ios",
    "android": "npm run cap:sync && cap open android"
  },
  "dependencies": {
    "@capacitor/app": "latest",
    "@capacitor/core": "latest",
    "@capacitor/haptics": "latest",
    "@capacitor/share": "latest",
    "@capacitor/splash-screen": "latest",
    "@capacitor/status-bar": "latest"
  },
  "devDependencies": {
    "@capacitor/android": "latest",
    "@capacitor/assets": "latest",
    "@capacitor/cli": "latest",
    "@capacitor/ios": "latest"
  }
}
